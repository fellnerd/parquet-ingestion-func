# Environment Variables for Parquet Ingestion Function
# Copy this file to .env and fill in the values

# =============================================================================
# Azure Functions Core
# =============================================================================
AzureWebJobsStorage=UseDevelopmentStorage=true
FUNCTIONS_WORKER_RUNTIME=python
PYTHON_ENABLE_WORKER_EXTENSIONS=1

# =============================================================================
# Configuration Storage (where sources.json is stored)
# =============================================================================
# For local development with Azurite:
PARQUET_CONFIG_STORAGE_CONNECTION=UseDevelopmentStorage=true
# For production (connection string):
# PARQUET_CONFIG_STORAGE_CONNECTION=DefaultEndpointsProtocol=https;AccountName=xxx;AccountKey=xxx;EndpointSuffix=core.windows.net
# Or use Managed Identity (leave empty and set account name):
# PARQUET_CONFIG_STORAGE_ACCOUNT=stadlsdatavaultweu001

PARQUET_CONFIG_CONTAINER=config
PARQUET_CONFIG_BLOB=sources.json

# =============================================================================
# Parquet Output Storage (ADLS Gen2)
# =============================================================================
# For local development:
PARQUET_OUTPUT_CONNECTION=UseDevelopmentStorage=true
# For production:
# PARQUET_OUTPUT_CONNECTION=DefaultEndpointsProtocol=https;AccountName=xxx;AccountKey=xxx;EndpointSuffix=core.windows.net
# Or:
# PARQUET_OUTPUT_STORAGE_ACCOUNT=stadlsdatavaultweu001

PARQUET_OUTPUT_CONTAINER=stage-fs

# =============================================================================
# Timer Schedules (CRON format)
# =============================================================================
# Main fetch schedule (every 15 minutes)
PARQUET_FETCH_SCHEDULE=0 */15 * * * *
# Buffer flush schedule (every hour)
PARQUET_BUFFER_FLUSH_SCHEDULE=0 0 * * * *

# =============================================================================
# Source-specific overrides (example)
# Pattern: SOURCE_{SOURCE_ID}_SETTING
# =============================================================================

# Jira
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

# Werkportal
WERKPORTAL_API_URL=https://api.werkportal.example.com
WERKPORTAL_API_TOKEN=your-werkportal-token

# ERP System
ERP_API_URL=https://erp.example.com/api
ERP_API_KEY=your-erp-api-key

# =============================================================================
# Misc
# =============================================================================
PARQUET_FUNC_VERSION=1.0.0

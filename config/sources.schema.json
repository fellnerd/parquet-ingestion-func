{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sources Configuration Schema",
  "description": "Schema for parquet-ingestion sources configuration",
  "type": "object",
  "required": ["version", "sources"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "Configuration version"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/source"
      }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "required": ["id", "concept", "source", "entity", "fetch"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+/[a-z0-9]+/[a-z0-9_]+$",
          "description": "Unique source identifier (format: concept/source/entity)"
        },
        "concept": {
          "type": "string",
          "description": "Concept/domain name"
        },
        "source": {
          "type": "string",
          "description": "Source system name"
        },
        "entity": {
          "type": "string",
          "description": "Entity/object name"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description"
        },
        "fetch": {
          "$ref": "#/definitions/fetchConfig"
        },
        "schedule": {
          "$ref": "#/definitions/scheduleConfig"
        },
        "response": {
          "$ref": "#/definitions/responseConfig"
        },
        "buffer": {
          "$ref": "#/definitions/bufferConfig"
        },
        "output": {
          "$ref": "#/definitions/outputConfig"
        }
      }
    },
    "fetchConfig": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["active", "passive"],
          "description": "active = polls API, passive = receives webhooks"
        },
        "endpoint": {
          "type": "string",
          "description": "API endpoint URL (supports ${ENV_VAR} placeholders)"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT"],
          "default": "GET"
        },
        "timeout": {
          "type": "integer",
          "default": 30,
          "description": "Request timeout in seconds"
        },
        "auth": {
          "$ref": "#/definitions/authConfig"
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "params": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Query parameters (supports {fetch_window_minutes} placeholder)"
        },
        "body": {
          "type": "object",
          "description": "Request body for POST/PUT (supports {last_fetch_timestamp} placeholder)"
        }
      }
    },
    "authConfig": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["none", "basic", "bearer", "api_key"]
        },
        "username": {
          "type": "string",
          "description": "For basic auth"
        },
        "password": {
          "type": "string",
          "description": "For basic auth"
        },
        "token": {
          "type": "string",
          "description": "For bearer auth"
        },
        "api_key": {
          "type": "string",
          "description": "For api_key auth"
        },
        "header_name": {
          "type": "string",
          "default": "X-API-Key",
          "description": "Header name for api_key auth"
        },
        "query_param_name": {
          "type": "string",
          "description": "Query param name for api_key auth (alternative to header)"
        }
      }
    },
    "scheduleConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "cron": {
          "type": "string",
          "description": "CRON expression for scheduled fetches"
        },
        "fetch_window_minutes": {
          "type": "integer",
          "default": 20,
          "description": "Overlap window for incremental fetches"
        }
      }
    },
    "responseConfig": {
      "type": "object",
      "properties": {
        "data_path": {
          "type": "string",
          "default": "$",
          "description": "JSONPath to data array (e.g., 'issues', 'data.rows')"
        },
        "schema_ref": {
          "type": "string",
          "description": "Reference to schema file for field mapping"
        }
      }
    },
    "bufferConfig": {
      "type": "object",
      "properties": {
        "min_rows": {
          "type": "integer",
          "default": 100,
          "description": "Minimum rows before flushing"
        },
        "max_rows": {
          "type": "integer",
          "default": 10000,
          "description": "Maximum rows before forced flush"
        },
        "max_age_minutes": {
          "type": "integer",
          "default": 60,
          "description": "Maximum buffer age before forced flush"
        }
      }
    },
    "outputConfig": {
      "type": "object",
      "properties": {
        "compression": {
          "type": "string",
          "enum": ["snappy", "gzip", "zstd", "none"],
          "default": "snappy"
        },
        "row_group_size": {
          "type": "integer",
          "default": 100000,
          "description": "Parquet row group size"
        }
      }
    }
  }
}
